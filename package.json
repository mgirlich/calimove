{
  "name": "calimove",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "fix": "oxfmt && oxlint src --fix",
    "lint:eslint": "eslint src",
    "lint:oxlint": "oxlint src --type-aware",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc -p ./tsconfig.app.json",
    "db:types": "npx supabase gen types typescript --linked > src/types/database.generated.ts",
    "db:extract": "bash scripts/extract.sh",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "data:generate": "node --env-file=.env.local scripts/generate-data.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "upload:audio": "node --env-file=.env.local --experimental-strip-types scripts/upload-audio.ts",
    "verify": "pnpm format && pnpm run lint && pnpm typecheck && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "@supabase/supabase-js": "2.117.3",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "oxlint --type-aware --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
